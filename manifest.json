{
  "manifest_version": 3,
  "name": "Dynamic Redirector",
  "version": "1.0",
  "description": "Redirects pages based on user-defined rules.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["redirector.js"],
      "run_at": "document_start"
    }
  ]
}
